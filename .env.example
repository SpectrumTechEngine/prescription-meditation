# Copy this file to .env.local and fill it in from
# Firebase console → Project settings → Your apps → Web app → firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# Optional: YouTube Data API v3 key. Without it the app links to a YouTube search
# instead of playing a specific video inside the app.
VITE_YOUTUBE_API_KEY=

# App Check: Fraud Defense (reCAPTCHA Enterprise) site key from console.cloud.google.com/security/recaptcha
VITE_RECAPTCHA_SITE_KEY=
