rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // The app's owner (full version and admin menu).
    function isOwner() { return signedIn() && request.auth.uid == 'ZqRpCKk693SVUiwWDGDATZm2qPn2'; }

    // Each person can read and write only their own data: prescriptions and app state.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Memos from Dr. Stillwell: everyone signed in can read them, only the owner can write them.
    match /memos/{memoId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Daily AI usage tally: every app adds to it, only the owner can read it.
    match /stats/{day} {
      allow read: if isOwner();
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['total', 'used', 'out', 'yt']);
    }

    // App stats: anonymous counts only (never names or anything anyone says).
    // Every app adds to them, only the owner can read them.
    match /metrics/{day} {
      allow read: if isOwner();
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly([
        'users', 'newUsers', 'active', 'activeWeek', 'consults', 'rx', 'rxFree', 'rxFull', 'swaps',
        'aftercare', 'favs', 'dislikes', 'reasons', 'limitHit', 'crisis', 'aiFull',
        'videoInApp', 'videoLink', 'techniques', 'teachers', 'deleted'
      ]);
    }
  }
}
